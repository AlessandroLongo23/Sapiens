# Copy to .env for local development. Values marked "public" are shipped to the browser.

# Public site origin. Change this once when the custom domain is attached; every
# canonical URL, og:url, sitemap entry and JSON-LD @id derives from it.
PUBLIC_SITE_URL=https://sapiens-edu.vercel.app

# Supabase (public anon key; row level security protects the data)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google Search Console HTML-tag verification token (content attribute only)
PUBLIC_GSC_VERIFICATION=

# Optional: address shown on /contacts. Leave empty to show the form only.
PUBLIC_CONTACT_EMAIL=

# Legal identity for /terms, /privacy and /cookie (see src/lib/config/legal.ts).
# Empty values are not rendered; the name falls back to the one in that file.
# Danish sole trader: PUBLIC_LEGAL_VAT is the CVR line, e.g. "CVR 12345678".
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_ADDRESS=
PUBLIC_LEGAL_VAT=
PUBLIC_PRIVACY_EMAIL=

# Stripe. A plan can be bought only when its price id is set; the six-month
# option is offered only when the matching *_SEMESTER price exists.
PUBLIC_STRIPE_PRICE_LITE=
PUBLIC_STRIPE_PRICE_BASE=
PUBLIC_STRIPE_PRICE_PRO=
PUBLIC_STRIPE_PRICE_LITE_SEMESTER=
PUBLIC_STRIPE_PRICE_BASE_SEMESTER=
PUBLIC_STRIPE_PRICE_PRO_SEMESTER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-only services
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# Sender of every email, on a domain verified in Resend (e.g. "Sapiens <ciao@sapiens.example>").
# Without it Resend's test sender is used, which delivers to the Resend account owner only.
MAIL_FROM=
# Inbox of the contact form (required for /contacts to send).
CONTACT_INBOX=
# Optional: copy of every marketplace notification.
TUTORING_NOTIFY_EMAIL=

# Tests and scripts (optional)
# E2E_BASE_URL: run the e2e suite against an already running server instead of `next start -p 4173`.
# E2E_SKIP_STRIPE_LISTEN=1: do not start `stripe listen` (webhook tests will then fail).
# SKIP_PLACEHOLDER_DB=1: check-placeholder scans the build only, not the database.
