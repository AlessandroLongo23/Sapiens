{
	"name": "sapiens",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=20.9"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build && node scripts/check-placeholder.mjs && node scripts/check-secrets.mjs && node scripts/check-bundle.mjs",
		"start": "next start",
		"preview": "next start -p 4173",
		"check": "next typegen && tsc --noEmit",
		"lint": "eslint src tests",
		"check:placeholder": "node scripts/check-placeholder.mjs",
		"check:secrets": "node scripts/check-secrets.mjs",
		"test:e2e": "playwright test",
		"screenshots:mobile": "node scripts/mobile-screenshots.mjs",
		"generate:images": "node scripts/generate-images.mjs",
		"cap:sync": "npx cap sync",
		"cap:add:android": "npx cap add android",
		"cap:open:android": "npx cap open android",
		"cap:add:ios": "npx cap add ios",
		"cap:open:ios": "npx cap open ios",
		"cap:dev:android": "adb reverse tcp:3000 tcp:3000; npx cap run android --live-reload --host localhost --port 3000 --forwardPorts 3000:3000",
		"cap:dev:ios": "node scripts/cap-dev-ios.mjs",
		"prepare": "husky",
		"test:smoke": "E2E_SKIP_STRIPE_LISTEN=1 playwright test --project=chromium tests/e2e/smoke.spec.ts",
		"check:bundle": "node scripts/check-bundle.mjs",
		"stickers": "node scripts/stickers/build.mjs"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.6",
		"@supabase/supabase-js": "^2.115.0",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-mathematics": "^3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"3dmol": "^2.5.5",
		"katex": "^0.18.7",
		"lucide-react": "^1.42.0",
		"markdown-it": "^15.0.1",
		"markdown-it-anchor": "^10.0.0",
		"next": "^16.3.4",
		"openai": "^7.10.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"resend": "^6.26.0",
		"server-only": "^0.0.1",
		"stripe": "^22.6.1",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.1",
		"@capacitor/app": "^8.1.1",
		"@capacitor/cli": "^8.5.1",
		"@capacitor/core": "^8.5.1",
		"@capacitor/ios": "^8.5.2",
		"@capacitor/splash-screen": "^8.0.2",
		"@fontsource/fraunces": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/katex": "^0.16.8",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@xmldom/xmldom": "^0.9.12",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"opentype.js": "^2.0.0",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs,cjs}": "eslint --max-warnings=0 --no-warn-ignored",
		"{stickers/**/*.{svg,json},public/stickers/*.svg,src/lib/zaino/sticker-catalog.json}": "node scripts/stickers/build.mjs --check"
	}
}
